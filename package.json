{
  "name": "mini-konveksi-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:https": "next dev --experimental-https",
    "dev:https-lan": "next dev --experimental-https --hostname 0.0.0.0 --port 3000",
    "dev:https-cert": "next dev --experimental-https --experimental-https-key ./certs/dev-key.pem --experimental-https-cert ./certs/dev-cert.pem --hostname 0.0.0.0 --port 3000",
    "cert:lan": "bash scripts/generate-lan-cert.sh",
    "tunnel:ngrok": "ngrok http 3000",
    "tunnel:localtunnel": "npx --yes localtunnel --port 3000",
    "tunnel:cloudflared": "cloudflared tunnel --url http://localhost:3000",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose down postgres",
    "db:dev": "docker compose --profile dev up postgres-dev -d",
    "db:dev-down": "docker compose --profile dev down postgres-dev",
    "db:reset": "drizzle-kit drop && drizzle-kit push",
    "docker:build": "docker build -t mini-konveksi-app .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy": "docker compose down && docker compose build --no-cache && docker compose up -d",
    "seed:admin": "npx tsx scripts/seed-admin.ts",
    "seed:demo": "npx tsx scripts/seed-demo-users.ts",
    "seed:master": "npx tsx scripts/seed-master.ts"
  },
  "dependencies": {
